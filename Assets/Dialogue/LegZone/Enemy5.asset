    color: {r: 0, g: 0, b: 0, a: 1}
  - speaker: 1
    textElements:
    - text: "\uBA54\uBAA8\uB9AC \uCE69\uC5D0 \uBB38\uC81C\uB77C\uB3C4 \uC0DD\uACBC\uB098?"
      bold: 0
