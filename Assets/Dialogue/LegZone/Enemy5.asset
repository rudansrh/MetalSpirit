    color: {r: 0, g: 0, b: 0, a: 1}
  - speaker: 1
    textElements:
    - text: "\uD558\uC9C0\uB9CC \uC6B0\uB9AC\uB294 \uC800\uACF3\uC5D0 \uB4E4\uC5B4\uAC08
