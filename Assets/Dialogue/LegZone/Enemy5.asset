  - speaker: 1
    textElements:
    - text: "\uC61B\uB0A0 \uC778\uAC04\uB4E4\uC740 "
      bold: 0
      color: {r: 0, g: 0, b: 0, a: 1}
    - text: "\uC138 \uC790\uB9AC\uC758 \uBE44\uBC00\uBC88\uD638"
      bold: 1
      color: {r: 0, g: 0, b: 0, a: 1}
    - text: "\uB97C \uC785\uB825\uD574 \uC800\uACF3\uC744 \uCD9C\uC785\uD588\uB2E4."
