      bold: 0
      color: {r: 0, g: 0, b: 0, a: 1}
    text: 
    textBold: 0
    color: {r: 0, g: 0, b: 0, a: 1}
  - speaker: 0
    textElements:
    - text: "\uC800\uAE30\uB294 \uBABB \uB4E4\uC5B4\uAC00\uB294 \uAC74\uAC00."
