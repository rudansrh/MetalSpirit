    color: {r: 0, g: 0, b: 0, a: 1}
  - speaker: 1
    portraitSprite: {fileID: 0}
    textElements:
    - text: "\uC774\uC0C1\uD55C \uC9C8\uBB38\uC744 \uD558\uB294\uAD70."
