  lines:
  - speaker: 1
    portraitSprite: {fileID: 3290172580784513831, guid: 74bb64d9c7627402d8fd262ca0d0adad, type: 3}
    textElements:
    - text: "\uC5B4~\uC774! \uAC70\uAE30 \uB108!"
      bold: 0
      color: {r: 1, g: 1, b: 1, a: 1}
    text: 
    textBold: 0
    color: {r: 0, g: 0, b: 0, a: 1}
  - speaker: 0
    portraitSprite: {fileID: 2358148765893468524, guid: df3d360f2163141f2a9755f6f0fa2e99, type: 3}
    textElements:
    - text: "\uB098\uB97C \uBD80\uB974\uB294 \uAC74\uAC00?"
      bold: 0
      color: {r: 1, g: 1, b: 1, a: 1}
    text: 
    textBold: 0
    color: {r: 0, g: 0, b: 0, a: 1}
  - speaker: 1
    portraitSprite: {fileID: 3290172580784513831, guid: 74bb64d9c7627402d8fd262ca0d0adad, type: 3}
    textElements:
    - text: "\uADF8\uB798, \uB108 \uB9D0\uD558\uB294 \uAC70\uC57C."
      bold: 0
      color: {r: 1, g: 1, b: 1, a: 1}
    text: 
    textBold: 0
    color: {r: 0, g: 0, b: 0, a: 1}
  - speaker: 1
    portraitSprite: {fileID: 3290172580784513831, guid: 74bb64d9c7627402d8fd262ca0d0adad, type: 3}
    textElements:
    - text: "\uC5EC\uAE30 \uC788\uB294 \uD3EC\uC2A4\uD130 \uBD24\uC5B4?"
      bold: 0
      color: {r: 1, g: 1, b: 1, a: 1}
    text: 
    textBold: 0
    color: {r: 0, g: 0, b: 0, a: 1}
  - speaker: 0
    portraitSprite: {fileID: 2358148765893468524, guid: df3d360f2163141f2a9755f6f0fa2e99, type: 3}
    textElements:
    - text: "\uD3EC\uC2A4\uD130?"
      bold: 0
      color: {r: 1, g: 1, b: 1, a: 1}
    text: 
    textBold: 0
    color: {r: 0, g: 0, b: 0, a: 1}
  - speaker: 1
    portraitSprite: {fileID: 3290172580784513831, guid: 74bb64d9c7627402d8fd262ca0d0adad, type: 3}
    textElements:
    - text: "\uC22B\uC790 \uBA87 \uAC00\uC9C0"
      bold: 1
      color: {r: 1, g: 1, b: 1, a: 1}
    - text: "\uB97C \uACC4\uC18D\uD574\uC11C \uB108\uD55C\uD14C \uBCF4\uC5EC\uC8FC\uB824\uB294
        \uADF8\uAC83\uB4E4."
      bold: 0
      color: {r: 1, g: 1, b: 1, a: 1}
    text: 
    textBold: 0
    color: {r: 0, g: 0, b: 0, a: 1}
  - speaker: 1
    portraitSprite: {fileID: 3290172580784513831, guid: 74bb64d9c7627402d8fd262ca0d0adad, type: 3}
    textElements:
    - text: "\uC544, \uBB3C\uB860 \uC804\uBD80 \uADF8\uB7F0 \uAC74 \uC544\uB2C8\uC9C0\uB9CC."
      bold: 0
      color: {r: 1, g: 1, b: 1, a: 1}
    text: 
    textBold: 0
    color: {r: 0, g: 0, b: 0, a: 1}
  - speaker: 0
    portraitSprite: {fileID: 2358148765893468524, guid: df3d360f2163141f2a9755f6f0fa2e99, type: 3}
    textElements:
    - text: "\uADF8\uB798\uC11C?"
      bold: 0
      color: {r: 1, g: 1, b: 1, a: 1}
    text: 
    textBold: 0
    color: {r: 0, g: 0, b: 0, a: 1}
  - speaker: 1
    portraitSprite: {fileID: 3290172580784513831, guid: 74bb64d9c7627402d8fd262ca0d0adad, type: 3}
    textElements:
    - text: "\uADF8\uB0E5, \uBB50. \uC8FC\uC758 \uAE4A\uAC8C \uC798 \uBCF4\uB77C\uB294
