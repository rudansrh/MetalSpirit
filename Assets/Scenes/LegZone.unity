    - target: {fileID: 2946606106766401466, guid: 78ee73c3063fc8240a2454e4ef347b81, type: 3}
      propertyPath: m_Name
      value: document (2)
      objectReference: {fileID: 0}
    - target: {fileID: 6978089568397602837, guid: 78ee73c3063fc8240a2454e4ef347b81, type: 3}
      propertyPath: documentContent
      value: "\uB85C\uBD07\uC744 \uD1B5\uD55C \uC790\uC720\uAC00 \uC544\uB2CC \uB85C\uBD07\uC744
        \uC704\uD55C \uC790\uC720\uB97C \uB2EC\uB77C!\r\n\uB85C\uBD07\uB3C4 \uC778\uAC04\uCC98\uB7FC
        \uC601\uD63C\uC774 \uC788\uB2E4!\r\n\uC601\uD63C\uC774 \uC788\uB294 \uC874\uC7AC\uB97C
        \uD568\uBD80\uB85C \uB2E4\uB8E8\uB294 \uAC8C \uB9D0\uC774 \uB418\uB294\uAC00?\r\n\uC774
        \uB3C4\uC2DC\uC758 \uC808\uBC18\uC740 \uADF8\uB7F0 \uD3D0\uAE30\uC7A5\uC774\uBA70,
        \uC9C0\uAE08\uB3C4 \uCEE4\uC9C0\uACE0 \uC788\uB2E4!\r\n\uACF5\uB3D9\uBB18\uC9C0\uB97C
        \uC6B8\uD0C0\uB9AC \uC0BC\uC544 \uC778\uAC04\uC744 \uAC00\uB450\uB294 \uC774
        \uB3C4\uC2DC\uAC00 \uC815\uB155 \uC633\uC740 \uAC83\uC778\uAC00?\r\n\uAC01\uC131\uD574\uB77C
        \uC2DC\uBBFC\uB4E4\uC774\uC5EC!\r\n\uAC01\uC131\uD574\uB77C \uB85C\uBD07\uB4E4\uC774\uC5EC!\r\n\uB85C\uBD07\uC740
        \uADF8\uC800 \uC18C\uBAA8\uD488\uC774 \uC544\uB2CC \uC6B0\uB9AC\uC640 \uAC19\uC740
        \uC874\uC7AC\uB2E4!\r\n\uBA38\uC9C0\uC54A\uC544 \uBAA8\uB450\uAC00 \uC774\uB97C
        \uC54C\uAC8C \uB420 \uD130\uC774\uB2C8 \uADF8\uB0A0\uC744 \uACE0\uB300\uD558\uB77C.\r\n
        \r\n- L.U.R.D. (Libaro Underground Robo-spirit Division)"
      objectReference: {fileID: 0}
    - target: {fileID: 6978089568397602837, guid: 78ee73c3063fc8240a2454e4ef347b81, type: 3}
      propertyPath: documentTextElements.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6978089568397602837, guid: 78ee73c3063fc8240a2454e4ef347b81, type: 3}
      propertyPath: documentTextElements.Array.data[0].text
      value: "\uB85C\uBD07\uC744 \uD1B5\uD55C \uC790\uC720\uAC00 \uC544\uB2CC \uB85C\uBD07\uC744
        \uC704\uD55C \uC790\uC720\uB97C \uB2EC\uB77C!\r\n\uB85C\uBD07\uB3C4 \uC778\uAC04\uCC98\uB7FC
        \uC601\uD63C\uC774 \uC788\uB2E4!\r\n\uC601\uD63C\uC774 \uC788\uB294 \uC874\uC7AC\uB97C
        \uD568\uBD80\uB85C \uB2E4\uB8E8\uB294 \uAC8C \uB9D0\uC774 \uB418\uB294\uAC00?\r\n\uC774
        \uB3C4\uC2DC\uC758 \uC808\uBC18\uC740 \uADF8\uB7F0 \uD3D0\uAE30\uC7A5\uC774\uBA70,
        \uC9C0\uAE08\uB3C4 \uCEE4\uC9C0\uACE0 \uC788\uB2E4!\r\n\uACF5\uB3D9\uBB18\uC9C0\uB97C
        \uC6B8\uD0C0\uB9AC \uC0BC\uC544 \uC778\uAC04\uC744 \uAC00\uB450\uB294 \uC774
        \uB3C4\uC2DC\uAC00 \uC815\uB155 \uC633\uC740 \uAC83\uC778\uAC00?\r\n\uAC01\uC131\uD574\uB77C
        \uC2DC\uBBFC\uB4E4\uC774\uC5EC!\r\n\uAC01\uC131\uD574\uB77C \uB85C\uBD07\uB4E4\uC774\uC5EC!\r\n\uB85C\uBD07\uC740
        \uADF8\uC800 \uC18C\uBAA8\uD488\uC774 \uC544\uB2CC \uC6B0\uB9AC\uC640 \uAC19\uC740
        \uC874\uC7AC\uB2E4!\r\n\uBA38\uC9C0\uC54A\uC544 \uBAA8\uB450\uAC00 \uC774\uB97C
        \uC54C\uAC8C \uB420 \uD130\uC774\uB2C8 \uADF8\uB0A0\uC744 \uACE0\uB300\uD558\uB77C.\r\n
        \r\n- L.U.R.D. (Libaro Underground Robo-spirit Division)"
