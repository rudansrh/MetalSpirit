    - target: {fileID: 6978089568397602837, guid: 78ee73c3063fc8240a2454e4ef347b81, type: 3}
      propertyPath: documentContent
      value: "\uD638\uB974\uD2F0\uAC00 \uCDA9\uC804 \uC2DC\uAC04\uC744 \uBB34\uC2DC\uD558\uACE0
        \uC774\uB07C\uB97C \uAE4E\uACE0 \uC788\uB2E4\r\n\uC778\uAC04\uC774 \uBCF4\uC544\uB3C4
        \uC9D1\uC911\uD558\uACE0 \uC788\uB2E4\uB294 \uAC8C \uB208\uC5D0 \uBCF4\uC600\uB2E4\r\n\uC544,
        \uC5ED\uC2DC \uB85C\uBD07\uC5D0\uAC8C\uB3C4 \uC601\uD63C\uC740 \uC788\uB294
        \uAC70\uC600\uC5B4\r\n"
