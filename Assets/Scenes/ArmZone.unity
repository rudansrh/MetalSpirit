    - target: {fileID: 6978089568397602837, guid: 78ee73c3063fc8240a2454e4ef347b81, type: 3}
      propertyPath: documentTextElements.Array.data[0].text
      value: "GH7\uC774 \uC774\uACF3\uC744 \uB2F4\uB2F9\uD558\uAC8C \uB41C 7\uC77C\uC9F8.\r\n\uC774\uC81C\uB294
        \uAE38\uC744 \uD5E4\uB9E4\uC9C0 \uC54A\uACE0 \uC798 \uB2E4\uB2C8\uB294 \uAC83
        \uAC19\uB2E4.\r\n\uBCBD\uC740 \uB9C8\uCE58 \uC0C8\uAC83\uCC98\uB7FC \uC774\uB07C\uC758
        \uD754\uC801\uC744 \uC870\uAE08\uB3C4 \uCC3E\uC544\uBCFC \uC218 \uC5C6\uB2E4."
